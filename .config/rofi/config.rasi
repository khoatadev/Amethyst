/* Launcher — chỉ dùng drun, đồng bộ phong cách Tokyo Night Moon */

configuration {
	/* Chỉ kích hoạt mode drun */
	modes: "drun";

	/* Hiển thị icon app */
	show-icons: true;

	/* Tìm kiếm mờ (fuzzy matching) */
	matching: "fuzzy";

	/* Prompt biểu tượng tìm kiếm */
	display-drun: "";

	/* drun chỉ hiển thị tên ứng dụng gọn gàng */
	drun-display-format: "{name}";
}

@theme "tokyonight"
