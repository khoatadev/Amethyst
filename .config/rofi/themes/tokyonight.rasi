/* Tokyo Night Moon — rofi theme
 * Bảng màu đồng bộ với kitty (tokyonight_moon):
 *   nền #222436 · inputbar #1e2030 · chọn #2d3f76 · viền #444a73 · chữ #c8d3f5 · accent #82aaff
 */

* {
	bg:          #222436F2;
	bg-alt:      #1e2030;
	bg-sel:      #2d3f76;
	border:      #444a73;
	fg:          #c8d3f5;
	fg-dim:      #828bb8;
	accent:      #82aaff;
	urgent:      #ff757f;

	font: "ComicShannsMono Nerd Font 11";
	background-color: transparent;
	text-color:       @fg;
	margin:           0px;
	padding:          0px;
}

/* Khung ngoài: hộp nổi ở giữa màn hình, viền hairline và bo góc mềm mại */
window {
	width:            600px;
	background-color: @bg;
	border:           1px;
	border-color:     @border;
	border-radius:    14px;
	padding:          20px;
	children:         [ mainbox ];
}

mainbox {
	children: [ inputbar, listview ];
	spacing:  16px;
}

/* Khung tìm kiếm: dạng pill nổi bật, bo góc mượt */
inputbar {
	children:         [ prompt, entry ];
	spacing:          10px;
	background-color: @bg-alt;
	border-radius:    10px;
	padding:          12px 16px;
}

prompt {
	text-color:     @accent;
	vertical-align: 0.5;
}

entry {
	text-color:        @fg;
	placeholder:       "Tìm kiếm ứng dụng...";
	placeholder-color: @fg-dim;
	vertical-align:    0.5;
}

/* Danh sách ứng dụng: hiển thị dọc 8 dòng, không thanh cuộn */
listview {
	lines:        8;
	fixed-height: false;
	spacing:      6px;
	scrollbar:    false;
}

element {
	padding:       10px 14px;
	border-radius: 8px;
	spacing:       12px;
	children:      [ element-icon, element-text ];
}

element-icon {
	size:           26px;
	vertical-align: 0.5;
}

element-text {
	text-color:     @fg;
	vertical-align: 0.5;
}

/* Hiệu ứng khi chọn (selected) */
element selected.normal {
	background-color: @bg-sel;
}

element-text selected.normal {
	text-color: @accent;
}

element-text selected.urgent {
	text-color: @urgent;
}

/* Hộp thông báo lỗi hoặc tin nhắn trợ giúp */
message {
	padding: 0 14px;
	margin:  0 0 10px 0;
}

textbox {
	text-color:     @fg-dim;
	vertical-align: 0.5;
}
